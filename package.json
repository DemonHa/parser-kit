{
  "name": "parser-kit-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" run build",
    "test": "vitest run",
    "types:check": "pnpm -r run types:check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "bench": "vitest bench --run",
    "bench:save": "vitest bench --run --outputJson=bench-baseline.json && node scripts/normalize-baseline.mjs",
    "bench:compare": "vitest bench --run --compare=bench-baseline.json",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "changeset:publish": "pnpm build && pnpm -r publish --access public --no-git-checks",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "husky": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
