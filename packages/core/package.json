{
  "name": "@database.io/parser-kit",
  "version": "1.0.0",
  "type": "module",
  "main": "./build/cjs/index.js",
  "module": "./build/esm/index.js",
  "types": "./build/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/esm/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "require": {
        "types": "./build/cjs/index.d.ts",
        "default": "./build/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["build"],
  "scripts": {
    "build": "rm -rf build && pnpm run build:esm && pnpm run build:cjs && node scripts/write-dist-pkgjson.mjs",
    "build:esm": "tsc -p tsconfig.esm.json && tsc-alias -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && tsc-alias -p tsconfig.cjs.json",
    "types:check": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "bench:save": "vitest bench --run --outputJson=bench-baseline.json && node scripts/normalize-baseline.mjs",
    "bench:compare": "vitest bench --run --compare=bench-baseline.json"
  },
  "dependencies": {
    "typescript": "catalog:"
  },
  "devDependencies": {
    "node-sql-parser": "catalog:",
    "tsc-alias": "catalog:",
    "vitest": "catalog:"
  }
}
