{
  "name": "@parser-kit/dbml",
  "version": "0.1.0",
  "description": "A typed DBML parser built on @parser-kit/core: Table, Ref, Enum, Project and the rest of the DBML language to a span-annotated AST, with error recovery.",
  "keywords": [
    "dbml",
    "dbml-parser",
    "dbdiagram",
    "database-markup-language",
    "parser",
    "ast",
    "schema",
    "erd",
    "database",
    "lexer",
    "typescript"
  ],
  "license": "MIT",
  "author": "DemonHa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DemonHa/parser-kit.git",
    "directory": "packages/dbml"
  },
  "homepage": "https://github.com/DemonHa/parser-kit/tree/main/packages/dbml#readme",
  "bugs": "https://github.com/DemonHa/parser-kit/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./build/cjs/index.js",
  "module": "./build/esm/index.js",
  "types": "./build/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/esm/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "require": {
        "types": "./build/cjs/index.d.ts",
        "default": "./build/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf build && pnpm run build:esm && pnpm run build:cjs && node scripts/write-dist-pkgjson.mjs",
    "build:esm": "tsc -p tsconfig.esm.json && tsc-alias -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && tsc-alias -p tsconfig.cjs.json",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@parser-kit/core": "workspace:^"
  },
  "devDependencies": {
    "@dbml/core": "catalog:",
    "@dbml/parse": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
