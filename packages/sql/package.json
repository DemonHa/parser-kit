{
  "name": "@parser-kit/sql",
  "version": "0.0.0",
  "description": "A typed PostgreSQL 17 parser built on @parser-kit/core: DDL, DML, queries and whole psql/pg_dump scripts to a span-annotated AST, with error recovery.",
  "keywords": [
    "sql",
    "sql-parser",
    "parser",
    "postgres",
    "postgresql",
    "pg",
    "ast",
    "ddl",
    "pg_dump",
    "lexer",
    "typescript"
  ],
  "license": "MIT",
  "author": "DemonHa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DemonHa/parser-kit.git",
    "directory": "packages/sql"
  },
  "homepage": "https://github.com/DemonHa/parser-kit/tree/main/packages/sql#readme",
  "bugs": "https://github.com/DemonHa/parser-kit/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./build/cjs/index.js",
  "module": "./build/esm/index.js",
  "types": "./build/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/esm/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "require": {
        "types": "./build/cjs/index.d.ts",
        "default": "./build/cjs/index.js"
      }
    },
    "./postgres": {
      "import": {
        "types": "./build/esm/postgres/index.d.ts",
        "default": "./build/esm/postgres/index.js"
      },
      "require": {
        "types": "./build/cjs/postgres/index.d.ts",
        "default": "./build/cjs/postgres/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "postgres": [
        "./build/cjs/postgres/index.d.ts"
      ]
    }
  },
  "files": [
    "build",
    "src",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf build && pnpm run build:esm && pnpm run build:cjs && node scripts/write-dist-pkgjson.mjs",
    "build:esm": "tsc -p tsconfig.esm.json && tsc-alias -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && tsc-alias -p tsconfig.cjs.json",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@parser-kit/core": "workspace:^"
  },
  "devDependencies": {
    "node-sql-parser": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
